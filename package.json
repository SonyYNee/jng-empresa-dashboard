{
  "name": "jng-projeto",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node apps/dashboard/src/server.js",
    "dev": "node --watch apps/dashboard/src/server.js",
    "test": "npm run test:dashboard && npm run test:landing",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:dashboard": "node --test apps/dashboard/tests/*.test.js",
    "test:landing": "npm --prefix apps/landing test",
    "dev:landing": "npm --prefix apps/landing run dev",
    "build:landing": "npm --prefix apps/landing run build",
    "preview:landing": "npm --prefix apps/landing run preview",
    "install:landing": "npm --prefix apps/landing ci"
  },
  "dependencies": {
    "pg": "^8.10.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
